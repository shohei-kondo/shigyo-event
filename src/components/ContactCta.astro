---
import { services } from '../data/common';
import { formLink } from '../lib/url';

interface Props {
  professionSlug: string;
}

const { professionSlug } = Astro.props;
const freePlan = services.find((s) => s.id === 'free')!;
---

<section class="section contact" id="contact">
  <div class="container container-narrow contact__inner">
    <h2 class="contact__title">まずは無料で相談してみませんか？</h2>
    <p class="contact__lead">
      「何から始めればよいか分からない」段階からご相談いただけます。<br />
      わかる範囲でフォームにご記入ください。未定の項目は空欄で問題ありません。
    </p>
    <a
      class="btn btn-primary btn-lg"
      href={formLink(freePlan.formSlug, { from: professionSlug, plan: 'free' })}
    >
      {freePlan.cta}
    </a>
  </div>
</section>

<style>
  .contact {
    background: linear-gradient(160deg, #1f3a5f 0%, #2b4f7d 100%);
    color: #fff;
  }

  .contact__inner {
    text-align: center;
  }

  .contact__title {
    color: #fff;
    font-size: clamp(1.4rem, 3.6vw, 2rem);
    margin: 0 0 16px;
  }

  .contact__lead {
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 28px;
  }
</style>
