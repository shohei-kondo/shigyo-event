---
import { empathy } from '../data/common';
---

<section class="section section-alt" id="empathy">
  <div class="container">
    <h2 class="section-title">{empathy.heading}</h2>
    <ul class="empathy__list">
      {
        empathy.items.map((item) => (
          <li class="empathy__item">
            <span class="empathy__check" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .empathy__list {
    list-style: none;
    margin: 8px auto 0;
    padding: 0;
    max-width: 820px;
    display: grid;
    gap: 12px;
  }

  .empathy__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 16px 20px;
    box-shadow: var(--shadow-sm);
  }

  .empathy__check {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 2px;
  }
</style>
