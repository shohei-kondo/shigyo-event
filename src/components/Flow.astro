---
import { flow } from '../data/common';
---

<section class="section section-alt" id="flow">
  <div class="container">
    <h2 class="section-title">ご相談の流れ</h2>
    <ol class="flow__list">
      {
        flow.map((step, i) => (
          <li class="flow__item">
            <span class="flow__num">{i + 1}</span>
            <div class="flow__body">
              <h3 class="flow__title">{step.title}</h3>
              <p class="flow__desc">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .flow__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 760px;
    display: grid;
    gap: 16px;
    counter-reset: flow;
  }

  .flow__item {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 20px 22px;
    box-shadow: var(--shadow-sm);
  }

  .flow__num {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .flow__title {
    margin: 4px 0 6px;
    font-size: 1.1rem;
  }

  .flow__desc {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
</style>
