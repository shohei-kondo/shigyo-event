---
interface Props {
  headline: string;
  lead: string;
  ctaHref: string;
  ctaLabel: string;
  label: string;
}

const { headline, lead, ctaHref, ctaLabel, label } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <p class="hero__eyebrow">{label}向け</p>
    <h1 class="hero__title">{headline}</h1>
    <p class="hero__lead">{lead}</p>
    <div class="hero__actions">
      <a class="btn btn-primary btn-lg" href={ctaHref}>{ctaLabel}</a>
      <a class="btn btn-outline" href="#services">サービス内容を見る</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, #1f3a5f 0%, #2b4f7d 60%, #355d90 100%);
    color: #fff;
    padding-block: clamp(56px, 9vw, 104px);
  }

  .hero__inner {
    max-width: 820px;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .hero__title {
    color: #fff;
    font-size: clamp(1.5rem, 4.6vw, 2.6rem);
    margin: 0 0 20px;
  }

  .hero__lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    margin: 0 auto 32px;
    max-width: 660px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  .hero__actions .btn-outline {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
  }

  .hero__actions .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
  }
</style>
