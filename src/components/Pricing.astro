---
import { services } from '../data/common';
import { formLink } from '../lib/url';

interface Props {
  professionSlug: string;
}

const { professionSlug } = Astro.props;
---

<section class="section section-alt" id="pricing">
  <div class="container">
    <h2 class="section-title">プラン・料金</h2>
    <p class="section-lead">
      分かりやすい料金で、必要なプランだけご利用いただけます。
    </p>

    <div class="pricing__table-wrap">
      <table class="pricing__table">
        <thead>
          <tr>
            <th scope="col">プラン</th>
            <th scope="col">内容</th>
            <th scope="col" class="pricing__price-col">料金</th>
            <th scope="col"><span class="visually-hidden">お申し込み</span></th>
          </tr>
        </thead>
        <tbody>
          {
            services.map((service) => (
              <tr>
                <th scope="row">{service.name}</th>
                <td>{service.heading}</td>
                <td class="pricing__price-col">
                  <span class={service.isFree ? 'pricing__free' : ''}>
                    {service.price}
                  </span>
                </td>
                <td>
                  <a
                    class="btn btn-outline pricing__cta"
                    href={formLink(service.formSlug, {
                      from: professionSlug,
                      plan: service.id,
                    })}
                  >
                    {service.cta}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="pricing__note">
      ※ 表示価格は税別の目安です。内容により変動する場合は、事前にお見積りします。
    </p>
  </div>
</section>

<style>
  .pricing__table-wrap {
    overflow-x: auto;
    max-width: 920px;
    margin-inline: auto;
  }

  .pricing__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    min-width: 640px;
  }

  .pricing__table th,
  .pricing__table td {
    padding: 16px 18px;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
    vertical-align: middle;
  }

  .pricing__table thead th {
    background: var(--color-primary);
    color: #fff;
    font-size: 0.95rem;
  }

  .pricing__table tbody th {
    color: var(--color-primary);
    font-size: 1.02rem;
    white-space: nowrap;
  }

  .pricing__table tbody tr:last-child th,
  .pricing__table tbody tr:last-child td {
    border-bottom: none;
  }

  .pricing__price-col {
    text-align: right;
    white-space: nowrap;
    font-weight: 700;
  }

  .pricing__free {
    color: var(--color-accent);
  }

  .pricing__cta {
    padding: 10px 18px;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .pricing__note {
    text-align: center;
    color: var(--color-ink-muted);
    font-size: 0.85rem;
    margin-top: 20px;
  }
</style>
