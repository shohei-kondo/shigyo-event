---
import { services } from '../data/common';
import { formLink } from '../lib/url';

interface Props {
  professionSlug: string;
}

const { professionSlug } = Astro.props;
---

<section class="section" id="services">
  <div class="container">
    <h2 class="section-title">サービス内容</h2>
    <p class="section-lead">
      必要なところだけお手伝いします。まずは無料相談からご利用いただけます。
    </p>

    <div class="services__grid">
      {
        services.map((service) => (
          <article class="card service">
            <div class="service__head">
              <span class={`service__price${service.isFree ? ' is-free' : ''}`}>
                {service.price}
              </span>
              <h3 class="service__name">{service.name}</h3>
            </div>
            <p class="service__heading">{service.heading}</p>
            <p class="service__desc">{service.description}</p>
            <ul class="service__items">
              {service.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a
              class={`btn ${service.isFree ? 'btn-primary' : 'btn-outline'}`}
              href={formLink(service.formSlug, {
                from: professionSlug,
                plan: service.id,
              })}
            >
              {service.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(3, 1fr);
  }

  .service {
    display: flex;
    flex-direction: column;
  }

  .service__head {
    margin-bottom: 12px;
  }

  .service__price {
    display: inline-block;
    font-weight: 700;
    color: var(--color-ink-soft);
    background: var(--color-bg-accent);
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 0.95rem;
    margin-bottom: 10px;
  }

  .service__price.is-free {
    color: var(--color-white);
    background: var(--color-accent);
  }

  .service__name {
    margin: 0;
    font-size: 1.25rem;
  }

  .service__heading {
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 10px;
  }

  .service__desc {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .service__items {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 8px;
    flex: 1;
  }

  .service__items li {
    position: relative;
    padding-left: 20px;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }

  .service__items li::before {
    content: "・";
    position: absolute;
    left: 2px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .service .btn {
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
