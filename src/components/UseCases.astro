---
interface Props {
  label: string;
  eventExamples: string[];
}

const { label, eventExamples } = Astro.props;
---

<section class="section" id="use-cases">
  <div class="container">
    <h2 class="section-title">利用シーン</h2>
    <p class="section-lead">
      {label}の幹事様から、こうしたイベントでご相談いただいています。
    </p>
    <ul class="usecases__list">
      {
        eventExamples.map((example) => (
          <li class="usecases__item">{example}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .usecases__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 820px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .usecases__item {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: 999px;
    padding: 10px 22px;
    font-weight: 700;
    font-size: 0.95rem;
  }
</style>
