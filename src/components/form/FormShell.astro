---
import { brand } from '../../data/common';
import { professions } from '../../data/professions';
import { FORM_ENDPOINT } from '../../config';

interface Props {
  /** プラン識別子（payload の plan に入る） */
  plan: string;
  /** フォームのスラッグ（payload の formType に入る） */
  formSlug: string;
  title: string;
  intro: string;
}

const { plan, formSlug, title, intro } = Astro.props;

// 流入元スラッグ -> 団体種別ラベルの対応表（profession_type の自動補完用）
const slugToLabel = Object.fromEntries(
  professions.map((p) => [p.slug, p.professionType])
);

// 送信先が未設定ならスタブ動作（実送信せず確認画面のみ）
const isStub = !FORM_ENDPOINT;
---

<section class="section">
  <div class="container container-narrow">
    <p class="form-shell__plan">{title}</p>
    <h1 class="form-shell__title">{title}フォーム</h1>
    <p class="form-shell__intro">{intro}</p>

    <form
      id="contact-form"
      class="form"
      method="post"
      action="#"
      novalidate
      data-form-type={formSlug}
      data-plan={plan}
      data-form-title={title}
      data-slug-map={JSON.stringify(slugToLabel)}
    >
      <input type="hidden" name="form_type" value={formSlug} />
      <input type="hidden" name="plan" value={plan} />
      <input type="hidden" name="source_page" value="" />

      <slot />

      <div class="form__actions">
        <button type="submit" id="form-submit" class="btn btn-primary btn-lg">
          送信する
        </button>
        <div id="form-status" class="form-status" role="alert" hidden></div>
        <p class="form__privacy">
          送信いただいた内容は、ご相談対応の目的にのみ利用します。
        </p>
      </div>
    </form>

    <div id="form-success" class="form-success" hidden>
      <h2 class="form-success__title">送信ありがとうございました</h2>
      {brand.autoReply.map((line) => <p>{line}</p>)}
      {
        isStub && (
          <p class="form-success__note">
            ※ 現在このフォームは検証用のため、送信内容はまだ自動送信されません。
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .form-shell__plan {
    display: inline-block;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .form-shell__title {
    margin: 0 0 12px;
    font-size: clamp(1.4rem, 3.4vw, 1.9rem);
  }

  .form-shell__intro {
    color: var(--color-ink-soft);
    margin-bottom: 32px;
  }

  .form__actions {
    margin-top: 8px;
    text-align: center;
  }

  .form__privacy {
    color: var(--color-ink-muted);
    font-size: 0.82rem;
    margin: 14px 0 0;
  }

  .form-success {
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 28px;
    text-align: center;
  }

  .form-success__title {
    margin: 0 0 16px;
  }

  .form-success__note {
    color: var(--color-ink-muted);
    font-size: 0.85rem;
    margin-top: 16px;
  }
</style>

<script>
  import { FORM_ENDPOINT } from '../../config';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById(
    'form-submit'
  ) as HTMLButtonElement | null;

  if (form) {
    const params = new URLSearchParams(window.location.search);

    // hidden: source_page（流入元LP）を URL クエリ from から取得。無ければ referrer。
    const from = params.get('from') ?? '';
    const sourceInput = form.querySelector<HTMLInputElement>(
      'input[name="source_page"]'
    );
    if (sourceInput) {
      sourceInput.value = from || document.referrer || 'direct';
    }

    // profession_type を流入元から自動補完
    const slugMap = JSON.parse(form.dataset.slugMap ?? '{}') as Record<
      string,
      string
    >;
    const label = slugMap[from];
    const professionSelect = form.querySelector<HTMLSelectElement>(
      'select[name="profession_type"]'
    );
    if (label && professionSelect) {
      const match = Array.from(professionSelect.options).find(
        (o) => o.value === label
      );
      if (match) professionSelect.value = label;
    }

    const setError = (fieldEl: Element, hasError: boolean) => {
      fieldEl.classList.toggle('field--error', hasError);
    };

    const validate = (): boolean => {
      let firstInvalid: Element | null = null;
      const fields = form.querySelectorAll<HTMLElement>('[data-field]');

      fields.forEach((fieldEl) => {
        let invalid = false;
        const group = fieldEl.dataset.group;
        const required = fieldEl.dataset.required === 'true';

        if (group === 'checkbox' || group === 'radio') {
          if (required) {
            const checked = fieldEl.querySelectorAll('input:checked').length;
            invalid = checked === 0;
          }
        } else {
          const control = fieldEl.querySelector<
            HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
          >('input, select, textarea');
          if (control && control.hasAttribute('required')) {
            invalid = !control.value.trim();
            if (
              !invalid &&
              control instanceof HTMLInputElement &&
              control.type === 'email'
            ) {
              invalid = !control.checkValidity();
            }
          }
        }

        setError(fieldEl, invalid);
        if (invalid && !firstInvalid) firstInvalid = fieldEl;
      });

      if (firstInvalid) {
        (firstInvalid as HTMLElement).scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      }
      return !firstInvalid;
    };

    // フィールド要素からラベル文字列を取得（必須/任意バッジを除去）
    const labelOf = (fieldEl: HTMLElement): string => {
      const labelEl = fieldEl.querySelector('.field__label, legend');
      if (!labelEl) return '';
      const clone = labelEl.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('.field__req').forEach((n) => n.remove());
      return (clone.textContent ?? '').trim();
    };

    // フィールド要素から入力値を取得
    const valueOf = (fieldEl: HTMLElement): string => {
      const group = fieldEl.dataset.group;
      if (group === 'checkbox') {
        return Array.from(
          fieldEl.querySelectorAll<HTMLInputElement>('input:checked')
        )
          .map((i) => i.value)
          .join(', ');
      }
      if (group === 'radio') {
        const checked = fieldEl.querySelector<HTMLInputElement>('input:checked');
        return checked ? checked.value : '';
      }
      const control = fieldEl.querySelector<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >('input, select, textarea');
      return control ? control.value.trim() : '';
    };

    const buildPayload = () => {
      const fields = Array.from(
        form.querySelectorAll<HTMLElement>('[data-field]')
      ).map((fieldEl) => ({ label: labelOf(fieldEl), value: valueOf(fieldEl) }));

      const getByName = (name: string) =>
        (
          form.querySelector<
            HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
          >(`[name="${name}"]`)?.value ?? ''
        ).trim();

      return {
        formType: form.dataset.formType ?? '',
        formTitle: form.dataset.formTitle ?? '',
        plan: form.dataset.plan ?? '',
        sourcePage: sourceInput?.value ?? '',
        professionType: getByName('profession_type'),
        email: getByName('email'),
        name: getByName('name'),
        fields,
        submittedAt: new Date().toISOString(),
        userAgent: navigator.userAgent,
        monitoring: false,
      };
    };

    const setStatus = (type: 'error' | 'sending' | '', message: string) => {
      if (!statusEl) return;
      if (!message) {
        statusEl.hidden = true;
        statusEl.className = 'form-status';
        statusEl.textContent = '';
        return;
      }
      statusEl.hidden = false;
      statusEl.className = `form-status form-status--${type}`;
      statusEl.textContent = message;
    };

    const showSuccess = () => {
      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('', '');
      if (!validate()) return;

      const payload = buildPayload();

      // 送信先未設定: スタブ動作（実送信せず確認画面を表示）
      if (!FORM_ENDPOINT) {
        // eslint-disable-next-line no-console
        console.info('[stub] form submission', payload);
        showSuccess();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '送信中...';
      }
      setStatus('sending', '送信しています。画面を閉じずにお待ちください。');

      try {
        const response = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !result.ok) {
          throw new Error(result.error || '送信に失敗しました。');
        }
        setStatus('', '');
        showSuccess();
      } catch (error) {
        const message =
          error instanceof Error ? error.message : '送信に失敗しました。';
        setStatus(
          'error',
          `送信できませんでした。時間をおいて再度お試しください。（${message}）`
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '送信する';
        }
      }
    });
  }
</script>
