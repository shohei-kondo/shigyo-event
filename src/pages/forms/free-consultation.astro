---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormShell from '../../components/form/FormShell.astro';
import TextField from '../../components/form/TextField.astro';
import SelectField from '../../components/form/SelectField.astro';
import TextArea from '../../components/form/TextArea.astro';
import CheckboxGroup from '../../components/form/CheckboxGroup.astro';
import RadioGroup from '../../components/form/RadioGroup.astro';
import {
  professionTypeOptions,
  eventTypeOptions,
  attendeeOptions,
  periodOptions,
  consultTopicOptions,
  consultMethodOptions,
} from '../../data/forms';
---

<BaseLayout title="企画相談フォーム｜イベント幹事サポート" noindex={true}>
  <FormShell
    plan="free"
    formSlug="free-consultation"
    title="企画の無料相談"
    intro="まだ内容が固まっていない段階でもご相談いただけます。わかる範囲でご記入ください。未定の項目は空欄のままで問題ありません。"
  >
    <TextField name="name" label="お名前" required placeholder="例：山田 太郎" />
    <TextField name="email" label="メールアドレス" type="email" required placeholder="例：taro@example.com" />
    <TextField name="organization" label="所属団体・支部名" placeholder="例：〇〇士会 港支部" />
    <SelectField name="profession_type" label="士業・団体種別" options={professionTypeOptions} required />
    <SelectField name="event_type" label="予定しているイベント種別" options={eventTypeOptions} />
    <SelectField name="attendees" label="想定参加人数" options={attendeeOptions} />
    <SelectField name="period" label="開催予定時期" options={periodOptions} />
    <CheckboxGroup name="consult_topics" legend="相談したいこと" options={consultTopicOptions} required />
    <TextArea name="consult_detail" label="相談したいこと（自由記述）" placeholder="ご相談内容を自由にご記入ください。" />
    <RadioGroup name="consult_method" legend="無料相談の希望方法" options={consultMethodOptions} required />
    <TextField name="contact_time" label="希望連絡時間帯" placeholder="例：平日10〜17時" />
  </FormShell>
</BaseLayout>
